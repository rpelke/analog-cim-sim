// Dev container for analog-cim-sim.
// Docs: https://containers.dev/implementors/json_reference/
{
    "name": "analog-cim-sim",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    // Initializes submodules and the .venv (see requirements.txt).
    "postCreateCommand": "./.devcontainer/post_create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                // C++ / CMake toolchain. clangd owns IntelliSense and
                // formatting, cpptools is kept only for its cppdbg (gdb)
                // debug adapter, with its own engine disabled below.
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "ms-vscode.cpp-devtools",
                // Python bindings + unittest
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                // yapf is the formatter this repo enforces (.style.yapf,
                // ./util/format_py.py).
                "eeyore.yapf",
                // README is linted by pymarkdown in the Style workflow, and the
                // support matrix is a wide Markdown table
                "davidanson.vscode-markdownlint",
                "darkriszty.markdown-table-prettify",
                // scripts/*.sh: LSP driven by the image's shellcheck and shfmt
                "mads-hartmann.bash-ide-vscode",
                // .github/workflows/*.yml
                "github.vscode-github-actions"
            ],
            "settings": {
                // --- Python -------------------------------------------------
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
                "python.terminal.activateEnvInCurrentTerminal": true,
                "python.testing.unittestEnabled": true,
                "python.testing.pytestEnabled": false,
                "python.testing.unittestArgs": [
                    "-s",
                    "int-bindings/test",
                    "-p",
                    "*_test.py"
                ],
                // Format with yapf against the repo's .style.yapf, i.e. exactly
                // what ./util/format_py.py checks in the Style workflow.
                "yapf.interpreter": [
                    "${workspaceFolder}/.venv/bin/python"
                ],
                "yapf.args": [
                    "--style",
                    "${workspaceFolder}/.style.yapf"
                ],
                "[python]": {
                    "editor.defaultFormatter": "eeyore.yapf",
                    "editor.formatOnSave": true
                },
                // --- C++ / CMake --------------------------------------------
                "cmake.sourceDirectory": "${workspaceFolder}/cpp",
                "cmake.buildDirectory": "${workspaceFolder}/build/debug/build",
                "cmake.configureOnOpen": false,
                // clangd is the language server.
                "C_Cpp.intelliSenseEngine": "disabled",
                "clangd.path": "/usr/bin/clangd-18",
                "clangd.arguments": [
                    // The database compiles with g++-13 -> ask that driver for its
                    // libstdc++ include paths instead of guessing them.
                    "--query-driver=/usr/bin/g++*",
                    "--background-index"
                ],
                "[cpp]": {
                    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
                    "editor.formatOnSave": true
                },
                "[c]": {
                    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
                    "editor.formatOnSave": true
                },
                // --- Markdown -----------------------------------------------
                // Mirrors .pymarkdown.
                "markdownlint.configFile": ".devcontainer/markdownlint.yaml",
                // --- Shell ----------------------------------------------------
                // shfmt takes its indent from the editor, so set it here.
                "[shellscript]": {
                    "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode",
                    "editor.formatOnSave": true,
                    "editor.tabSize": 4,
                    "editor.insertSpaces": true
                },
                "bashIde.shfmt.caseIndent": true,
                // --- Misc ---------------------------------------------------
                "files.watcherExclude": {
                    "**/build/**": true,
                    "**/.venv/**": true,
                    "**/.cache/**": true
                },
                "search.exclude": {
                    "**/build": true,
                    "**/.venv": true,
                    "**/.cache": true,
                    "cpp/extern": true,
                    "cpp/test/googletest": true
                }
            }
        }
    }
}
